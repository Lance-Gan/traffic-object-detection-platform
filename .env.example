APP_ENV=development
LOG_LEVEL=INFO
SQL_ECHO=false

MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=traffic_detection
MYSQL_USER=traffic_app
MYSQL_PASSWORD=change_me_app_password
MYSQL_PORT=3306

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=traffic_detection
DB_USER=traffic_app
DB_PASSWORD=change_me_app_password

MODEL_NAME=yolo26n.pt
INFERENCE_DEVICE=auto
DEFAULT_CONFIDENCE_THRESHOLD=0.2500
MAX_IMAGE_UPLOAD_BYTES=26214400

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

CELERY_BROKER_URL=redis://:change_me_redis_password@127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://:change_me_redis_password@127.0.0.1:6379/1

MAX_VIDEO_UPLOAD_BYTES=262144000
MAX_VIDEO_DURATION_SECONDS=120
VIDEO_TARGET_FPS=10

CAMERA_TARGET_FPS=5
CAMERA_FRAME_WIDTH=640
CAMERA_JPEG_QUALITY=0.72

CAMERA_MAX_FRAME_BYTES=2097152
CAMERA_MAX_FRAME_PIXELS=921600
CAMERA_MAX_SESSION_SECONDS=600

CAMERA_TRACKER_NAME=bytetrack.yaml

VIDEO_TRACKER_NAME=bytetrack.yaml
VIDEO_INFERENCE_SIZE=640
VIDEO_OUTPUT_MAX_WIDTH=1280

LOG_LEVEL=INFO

ALLOWED_HOSTS=["127.0.0.1","localhost"]

MAX_REQUEST_BODY_BYTES=283115520