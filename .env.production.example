APP_VERSION=1.0.0
LOG_LEVEL=INFO
ENABLE_API_DOCS=true

WEB_PORT=8080

MYSQL_ROOT_PASSWORD=replace_with_random_root_password
MYSQL_DATABASE=traffic_detection
MYSQL_USER=traffic_app
MYSQL_PASSWORD=replace_with_random_application_password

REDIS_PASSWORD=replace_with_random_redis_password

MODEL_FILE_NAME=yolo26n.pt

DEFAULT_CONFIDENCE_THRESHOLD=0.2500

MAX_IMAGE_UPLOAD_BYTES=26214400

MAX_VIDEO_UPLOAD_BYTES=262144000
MAX_VIDEO_DURATION_SECONDS=120
VIDEO_TARGET_FPS=10
VIDEO_TRACKER_NAME=bytetrack.yaml
VIDEO_INFERENCE_SIZE=640
VIDEO_OUTPUT_MAX_WIDTH=1280

CAMERA_TARGET_FPS=5
CAMERA_FRAME_WIDTH=640
CAMERA_JPEG_QUALITY=0.72
CAMERA_MAX_FRAME_BYTES=2097152
CAMERA_MAX_FRAME_PIXELS=921600
CAMERA_MAX_SESSION_SECONDS=600
CAMERA_TRACKER_NAME=bytetrack.yaml

MAX_REQUEST_BODY_BYTES=283115520

CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]